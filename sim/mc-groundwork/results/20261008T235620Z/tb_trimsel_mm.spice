XXDUT vdd 0 clk t0 t1 t2 t3 t4 t5 t6 t7 rcosc_top
VDD vdd 0 DC 3.3
VT0 t0 0 DC 0
VT1 t1 0 DC 0
VT2 t2 0 DC 0
VT3 t3 0 DC 0
VT4 t4 0 DC 0
VT5 t5 0 DC 0
VT6 t6 0 DC 0
VT7 t7 0 DC 0
* Calibration search lives in the body (klt sim owns the final control block; the
* search needs several solves per sample -- see README.md, tool-gap section).
.control
set noaskquit
set measureprec=8
* Each tran makes a new current plot; the search state lives in a plot of its own.
setplot new
set sp = $curplot
let tgt = 4.8e+07
let lo = -1
let hi = 256
let flo = -1e12
let fhi = 1e12
while hi - lo > 1
  let mid = floor((lo + hi) / 2)
  let vb = 3.3 * (floor(mid / 1) - 2 * floor(mid / 2))
  alter vt0 = $&vb
  let vb = 3.3 * (floor(mid / 2) - 2 * floor(mid / 4))
  alter vt1 = $&vb
  let vb = 3.3 * (floor(mid / 4) - 2 * floor(mid / 8))
  alter vt2 = $&vb
  let vb = 3.3 * (floor(mid / 8) - 2 * floor(mid / 16))
  alter vt3 = $&vb
  let vb = 3.3 * (floor(mid / 16) - 2 * floor(mid / 32))
  alter vt4 = $&vb
  let vb = 3.3 * (floor(mid / 32) - 2 * floor(mid / 64))
  alter vt5 = $&vb
  let vb = 3.3 * (floor(mid / 64) - 2 * floor(mid / 128))
  alter vt6 = $&vb
  let vb = 3.3 * (floor(mid / 128) - 2 * floor(mid / 256))
  alter vt7 = $&vb
  tran 200p 1200n
  meas tran ta when v(clk)=1.6500 rise=5
  meas tran tb when v(clk)=1.6500 rise=25
  let fq = 20 / (tb - ta)
  set fq_s = $&fq
  setplot $sp
  let fm = $fq_s
  if fm < tgt
    let lo = mid
    let flo = fm
  else
    let hi = mid
    let fhi = fm
  end
end
if abs(flo - tgt) <= abs(fhi - tgt)
  let csel = lo
  let fsel = flo
else
  let csel = hi
  let fsel = fhi
end
  let vb = 3.3 * (floor(csel / 1) - 2 * floor(csel / 2))
  alter vt0 = $&vb
  let vb = 3.3 * (floor(csel / 2) - 2 * floor(csel / 4))
  alter vt1 = $&vb
  let vb = 3.3 * (floor(csel / 4) - 2 * floor(csel / 8))
  alter vt2 = $&vb
  let vb = 3.3 * (floor(csel / 8) - 2 * floor(csel / 16))
  alter vt3 = $&vb
  let vb = 3.3 * (floor(csel / 16) - 2 * floor(csel / 32))
  alter vt4 = $&vb
  let vb = 3.3 * (floor(csel / 32) - 2 * floor(csel / 64))
  alter vt5 = $&vb
  let vb = 3.3 * (floor(csel / 64) - 2 * floor(csel / 128))
  alter vt6 = $&vb
  let vb = 3.3 * (floor(csel / 128) - 2 * floor(csel / 256))
  alter vt7 = $&vb
  tran 200p 1200n
  meas tran ta when v(clk)=1.6500 rise=5
  meas tran tb when v(clk)=1.6500 rise=25
  let fq = 20 / (tb - ta)
  set fq_s = $&fq
  setplot $sp
  let fhold = $fq_s
let fres_pct = (fhold - tgt) / tgt * 100
let fgap = abs(fhold - fsel)
set v_code = $&csel
set v_fsel = $&fsel
set v_fhold = $&fhold
set v_res = $&fres_pct
set v_gap = $&fgap
.endc
