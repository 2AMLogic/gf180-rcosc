{
  "netlist": "tb_v33_msb_first.spice",
  "engine": "ngspice",
  "netlist_source": "schematic",
  "models": {
    "pdk": "gf180mcuC",
    "lib": "libs.tech/ngspice/sm141064.ngspice"
  },
  "corners": {
    "process": [
      {
        "name": "tt",
        "sections": [
          "typical",
          "res_typical",
          "mimcap_typical",
          "cap_mim"
        ]
      },
      {
        "name": "ss",
        "sections": [
          "ss",
          "res_ss",
          "mimcap_ss",
          "cap_mim"
        ]
      },
      {
        "name": "ff",
        "sections": [
          "ff",
          "res_ff",
          "mimcap_ff",
          "cap_mim"
        ]
      }
    ],
    "temperature_c": [
      27.0
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "100p 31400n 0 100p"
  },
  "measurements": [
    {
      "name": "t_first_edge",
      "unit": "s",
      "spice": ".meas tran t_first_edge WHEN v(clk)=1.6500 RISE=1"
    }
  ],
  "batch": {
    "capacity_wait_s": 1200
  },
  "options": {
    "timeout_s": 7200,
    "keep_artifacts": true,
    "waveforms": true,
    "save_mode": "netlist",
    "ngspice_init": [
      "set measureprec=8"
    ]
  }
}
