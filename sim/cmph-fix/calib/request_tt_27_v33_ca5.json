{
  "netlist": "tb_tt_27_v33_ca5.spice",
  "engine": "ngspice",
  "netlist_source": "extracted",
  "models": {
    "pdk": "gf180mcuC",
    "lib": "libs.tech/ngspice/sm141064.ngspice"
  },
  "corners": {
    "process": [
      {
        "name": "tt",
        "sections": [
          "typical",
          "res_typical",
          "mimcap_typical",
          "cap_mim"
        ]
      }
    ],
    "temperature_c": [
      27.0
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "200p 1200n"
  },
  "measurements": [
    {
      "name": "ta",
      "spice": ".meas tran ta WHEN v(clk)=1.6500 RISE=5",
      "unit": "s"
    },
    {
      "name": "tb",
      "spice": ".meas tran tb WHEN v(clk)=1.6500 RISE=25",
      "unit": "s"
    },
    {
      "name": "fosc",
      "spice": ".meas tran fosc PARAM='20/(tb-ta)'",
      "unit": "Hz"
    },
    {
      "name": "clk_max",
      "spice": ".meas tran clk_max MAX v(clk) FROM=200n",
      "unit": "V"
    },
    {
      "name": "clk_min",
      "spice": ".meas tran clk_min MIN v(clk) FROM=200n",
      "unit": "V"
    },
    {
      "name": "iq_run_ua",
      "spice": ".meas tran iq_run_ua AVG v(iq_ua) FROM=200n TO=1200n",
      "unit": "uA"
    }
  ],
  "options": {
    "timeout_s": 1800,
    "keep_artifacts": true,
    "ngspice_init": [
      "set measureprec=8"
    ]
  }
}
