{
  "netlist": "tb_c00_v30.spice",
  "engine": "ngspice",
  "netlist_source": "extracted",
  "models": {
    "pdk": "gf180mcuC",
    "lib": "libs.tech/ngspice/sm141064.ngspice"
  },
  "corners": {
    "process": [
      {
        "name": "tt",
        "sections": [
          "typical",
          "res_typical",
          "mimcap_typical",
          "cap_mim"
        ]
      },
      {
        "name": "ff",
        "sections": [
          "ff",
          "res_ff",
          "mimcap_ff",
          "cap_mim"
        ]
      },
      {
        "name": "ss",
        "sections": [
          "ss",
          "res_ss",
          "mimcap_ss",
          "cap_mim"
        ]
      }
    ],
    "temperature_c": [
      -40.0,
      27.0,
      85.0
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "200p 4000n"
  },
  "measurements": [
    {
      "name": "f_ta",
      "spice": ".meas tran f_ta WHEN v(clk)=1.5000 RISE=5",
      "unit": "s"
    },
    {
      "name": "f_tb",
      "spice": ".meas tran f_tb WHEN v(clk)=1.5000 RISE=25",
      "unit": "s"
    },
    {
      "name": "q_a",
      "spice": ".meas tran q_a FIND v(qint) WHEN v(clk)=1.5000 RISE=5",
      "unit": "V"
    },
    {
      "name": "q_b",
      "spice": ".meas tran q_b FIND v(qint) WHEN v(clk)=1.5000 RISE=25",
      "unit": "V"
    },
    {
      "name": "iq_run",
      "spice": ".meas tran iq_run PARAM='(q_b-q_a)*1n/(f_tb-f_ta)'",
      "unit": "A"
    }
  ],
  "batch": {
    "capacity_wait_s": 600
  },
  "options": {
    "timeout_s": 1800,
    "keep_artifacts": true,
    "ngspice_init": [
      "set measureprec=8"
    ]
  }
}
