{
  "netlist": "tb_tt_v30.spice",
  "engine": "ngspice",
  "netlist_source": "extracted",
  "models": {
    "pdk": "gf180mcuC",
    "lib": "libs.tech/ngspice/sm141064.ngspice"
  },
  "corners": {
    "process": [
      {
        "name": "tt",
        "sections": [
          "typical",
          "res_typical",
          "mimcap_typical",
          "cap_mim"
        ]
      }
    ],
    "temperature_c": [
      -40.0,
      27.0,
      85.0
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "200p 1200n"
  },
  "measurements": [
    {
      "name": "f_ta",
      "spice": ".meas tran f_ta WHEN v(clk)=1.5000 RISE=5",
      "unit": "s"
    },
    {
      "name": "f_tb",
      "spice": ".meas tran f_tb WHEN v(clk)=1.5000 RISE=25",
      "unit": "s"
    },
    {
      "name": "fosc",
      "spice": ".meas tran fosc PARAM='20/(f_tb-f_ta)'",
      "unit": "Hz"
    }
  ],
  "batch": {
    "capacity_wait_s": 600
  },
  "options": {
    "timeout_s": 3600,
    "keep_artifacts": true,
    "ngspice_init": [
      "set measureprec=8"
    ]
  }
}
